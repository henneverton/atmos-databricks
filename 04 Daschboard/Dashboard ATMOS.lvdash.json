{
  "datasets": [
    {
      "name": "198e1198",
      "displayName": "perfil_sazonal_mensal",
      "config": {
        "version": "1.1",
        "source": "atmos.gold.perfil_sazonal_mensal",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "registro_mais_quente",
      "displayName": "Registro Mais Quente",
      "config": {
        "version": "1.1",
        "source": "SELECT ano, mes, cidade, temperatura_maxima_abs_c FROM atmos.gold.perfil_sazonal_mensal ORDER BY temperatura_maxima_abs_c DESC NULLS LAST LIMIT 1\n",
        "dimensions": [
          {
            "name": "ano",
            "expr": "`ano`",
            "displayName": "Ano"
          },
          {
            "name": "mes",
            "expr": "`mes`",
            "displayName": "Mês"
          },
          {
            "name": "cidade",
            "expr": "`cidade`",
            "displayName": "Cidade"
          },
          {
            "name": "rotulo",
            "expr": "CONCAT(CAST(`ano` AS STRING), ' - Mês ', CAST(`mes` AS STRING), ' - ', `cidade`)",
            "displayName": "Período"
          }
        ],
        "measures": [
          {
            "name": "temperatura_maxima",
            "expr": "MAX(`temperatura_maxima_abs_c`)",
            "displayName": "Temperatura Máxima (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "registro_mais_frio",
      "displayName": "Registro Mais Frio",
      "config": {
        "version": "1.1",
        "source": "SELECT ano, mes, cidade, temperatura_minima_abs_c FROM atmos.gold.perfil_sazonal_mensal ORDER BY temperatura_minima_abs_c ASC NULLS LAST LIMIT 1\n",
        "dimensions": [
          {
            "name": "rotulo",
            "expr": "CONCAT(CAST(`ano` AS STRING), ' - Mês ', CAST(`mes` AS STRING), ' - ', `cidade`)",
            "displayName": "Período"
          }
        ],
        "measures": [
          {
            "name": "temperatura_minima",
            "expr": "MIN(`temperatura_minima_abs_c`)",
            "displayName": "Temperatura Mínima (°C)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    }
  ],
